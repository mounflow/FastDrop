#define FASTDROP_ICON 3
#define FASTDROP_MANIFEST 1
#define FASTDROP_VERSION 1

FASTDROP_ICON ICON "fastdrop.ico"
FASTDROP_MANIFEST 24 "fastdrop.exe.manifest"

FASTDROP_VERSION VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "FastDrop\0"
            VALUE "FileDescription", "FastDrop LAN File Transfer\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "FastDrop\0"
            VALUE "OriginalFilename", "FastDrop.exe\0"
            VALUE "ProductName", "FastDrop\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
